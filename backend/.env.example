PORT=5000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/micron_auth
# Or MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/micron_auth?retryWrites=true&w=majority
